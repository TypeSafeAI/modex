{
  "name": "@modex/desktop",
  "version": "0.1.0",
  "description": "Modex desktop — a Codex-App-style GUI: projects, parallel agent threads, worktrees, inline approvals, and a live Changes panel.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/src/main/index.js",
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer && pnpm run build:usage",
    "build:main": "node scripts/prepare-terminal.mjs && tsc -p tsconfig.main.json && node scripts/copy-main-assets.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "pnpm run build:main && node --test \"dist/test/**/*.test.js\" && node --test test/browser-dev.test.mjs test/native-packages.test.mjs test/native-update-acceptance.test.mjs test/native-update-fault.test.mjs test/update-acceptance-artifacts.test.mjs",
    "start": "electron .",
    "dev": "pnpm --filter @modex/core build && pnpm run build:main && vite",
    "screenshot": "electron . --demo",
    "test:e2e": "pnpm run build && playwright test",
    "ui:capture": "pnpm run build && playwright test e2e/layout.spec.ts",
    "ui:compare": "node scripts/ui-compare.mjs",
    "dist": "pnpm run build && electron-builder --mac --arm64 --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "dist:release": "pnpm run build && electron-builder --mac --arm64 --publish never -c.mac.sign=./build/sign.cjs",
    "dev:usage": "vite --config vite.usage.config.ts",
    "build:usage": "vite build --config vite.usage.config.ts",
    "dist:windows": "pnpm --filter @modex/core build && pnpm run build && node scripts/package-native.mjs win32",
    "dist:linux": "pnpm --filter @modex/core build && pnpm run build && node scripts/package-native.mjs linux",
    "prepare:native-clis": "node scripts/prepare-native-clis.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@create-markdown/core": "2.0.3",
    "@create-markdown/react": "2.0.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@modex/core": "workspace:*",
    "node-pty": "1.2.0-beta.15",
    "qrcode": "^1.5.4",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1",
    "cmd-shim": "9.0.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "yazl": "3.3.1"
  },
  "productName": "Modex",
  "author": "Val Alexander / OpenCoven",
  "build": {
    "appId": "ai.typesafe.modex",
    "productName": "Modex",
    "protocols": [
      { "name": "Modex Desktop Host", "schemes": ["modex-host"] }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/src/main/**",
      "!dist/src/main/browser-dev.*",
      "!dist/src/main/commands.*",
      "dist/src/shared/**",
      "dist/renderer/**",
      "dist/usage-preview/**",
      "demo/**",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "dist/src/main/engine/terminal-supervisor",
      "dist/src/main/engine/cli-supervisor.exe",
      "dist/src/main/engine/desktop-system"
    ],
    "mac": {
      "extendInfo": {
        "ModexDesktopHostProtocol": 1,
        "ModexDesktopHostLaunchProtocol": 1,
        "NSLocalNetworkUsageDescription": "Let your paired iPhone find and reconnect to Modex on this Mac.",
        "NSBonjourServices": [
          "_modex._tcp"
        ]
      },
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "dmg": {
      "title": "Modex ${version}"
    },
    "artifactName": "Modex-${version}-${arch}.${ext}",
    "electronVersion": "44.4.5",
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../../docs/branding/modex-icon.png",
      "artifactName": "Modex-${version}-windows-${arch}.${ext}",
      "forceCodeSigning": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "executableName": "modex",
      "maintainer": "Val Alexander <val@opencoven.ai>",
      "artifactName": "Modex-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "deb": {
      "packageName": "modex"
    }
  },
  "homepage": "https://github.com/TypeSafeAI/modex"
}
