{
  "name": "@modex/desktop",
  "version": "0.0.7",
  "description": "Modex desktop \u2014 a Codex-App-style GUI: projects, parallel agent threads, worktrees, inline approvals, and a live Changes panel.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/src/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/prepare-terminal.mjs && tsc -p tsconfig.main.json && cp src/main/preload.cjs dist/src/main/preload.cjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "npm run build:main && node --test \"dist/test/**/*.test.js\" && node --test test/browser-dev.test.mjs",
    "start": "electron .",
    "predev": "npm run build -w @modex/core && npm run build:main",
    "dev": "vite",
    "screenshot": "electron . --demo",
    "test:e2e": "npm run build && playwright test",
    "ui:capture": "npm run build && playwright test e2e/layout.spec.ts",
    "ui:compare": "node scripts/ui-compare.mjs",
    "dist": "npm run build && electron-builder --mac --arm64 --publish never -c.mac.identity=- -c.mac.hardenedRuntime=false -c.mac.notarize=false",
    "dist:release": "npm run build && electron-builder --mac --arm64 --publish never -c.mac.sign=./build/sign.cjs"
  },
  "dependencies": {
    "@modex/core": "0.3.0",
    "node-pty": "1.2.0-beta.15",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "^44.4.5",
    "electron-builder": "26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.1"
  },
  "productName": "Modex",
  "author": "Val Alexander / OpenCoven",
  "build": {
    "appId": "ai.typesafe.modex",
    "productName": "Modex",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/src/main/**",
      "!dist/src/main/browser-dev.*",
      "!dist/src/main/commands.*",
      "dist/src/shared/**",
      "dist/renderer/**",
      "demo/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "dist/src/main/engine/terminal-supervisor",
      "dist/src/main/engine/desktop-system"
    ],
    "mac": {
      "extendInfo": {
        "ModexDesktopHostProtocol": 1,
        "NSLocalNetworkUsageDescription": "Let your paired iPhone find and reconnect to Modex on this Mac.",
        "NSBonjourServices": ["_modex._tcp"]
      },
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "dmg": {
      "title": "Modex ${version}"
    },
    "artifactName": "Modex-${version}-${arch}.${ext}",
    "electronVersion": "44.4.5",
    "npmRebuild": false
  }
}
